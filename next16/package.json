{
  "name": "next16",
  "author": "Dewdew",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3008",
    "build": "next build",
    "start": "next start --port 3008",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "benchmark:server": "node scripts/autocannon.js",
    "benchmark:lighthouse": "lighthouse http://localhost:3008 --output html --output-path ./benchmark-reports/lighthouse-next16.html --chrome-flags=\"--headless\"",
    "benchmark:inspect": "node --inspect --max-old-space-size=4096 node_modules/.bin/next start",
    "benchmark:lighthouse-ci": "lhci autorun"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "next": "16.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "^16.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^7.12.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "lighthouse": "^13.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
